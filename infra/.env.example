# Helixa infrastructure environment — copy to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# Admin connection used for migrations (alembic) and bootstrap scripts.
# Must point at the postgres:16 instance bound to 127.0.0.1:5432 (M0 compose).
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/helixa

# Application role credentials (non-superuser, no BYPASSRLS).
# Used by infra/bootstrap-app-role.sh to provision the helixa_app login role;
# the backend connects as this role.
APP_DB_USER=helixa_app
APP_DB_PASSWORD=CHANGE_ME
